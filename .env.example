# ---------------------------------------------------------------------------
# Bread House — variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# Ningún secreto real se commitea.
# ---------------------------------------------------------------------------

# Neon (Lakebase Postgres) --------------------------------------------------
# POOLED: el hostname lleva el sufijo `-pooler`. La usa la aplicación.
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECTA: sin `-pooler`. La usan las migraciones y el seed.
DATABASE_URL_UNPOOLED="postgresql://usuario:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (login del CRM en /admin) ---------------------------------------
NEXT_PUBLIC_STACK_PROJECT_ID=""
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=""
STACK_SECRET_SERVER_KEY=""

# Resend (correos transaccionales) ------------------------------------------
RESEND_API_KEY=""
CORREO_REMITENTE="reservas@breadhouse.cr"
# Destino de los avisos internos (nueva solicitud de evento, cancelación tardía).
CORREO_EQUIPO="equipo@breadhouse.cr"

# Endpoint externo para Pani (agente de WhatsApp) ---------------------------
# Clave que autentica POST /api/reservations/external.
# Generala con: openssl rand -hex 32
PANI_API_KEY=""

# Firma de los links de cancelar/reprogramar sin login ----------------------
# Generala con: openssl rand -hex 32
CANCEL_TOKEN_SECRET=""

# URL pública del sitio (correos y metadata) --------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
